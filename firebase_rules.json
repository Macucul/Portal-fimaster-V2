{
  "rules": {
    "dados": {
      "indice": {
        "licenca": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        }
      },
      "indices": {
        "licenca": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        },
        "instrucoes_admin_templates": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.admin === true"
        }
      },
      "parametros": {
        "$mt5AccountId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "config": {
        "$mt5AccountId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "status": {
        "$mt5AccountId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "eventos": {
        "$mt5AccountId": {
          ".read": "auth != null",
          ".write": "auth != null",
          "capturar_tela": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "captura_tela": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "notificacao_mql5": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "historico_patrimonio": {
          "$mt5AccountId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      },
      "usuarios": {
        "$userId": {
          ".read": "auth != null && (auth.uid == $userId || auth.token.admin === true)",
          ".write": "auth != null && (auth.uid == $userId || auth.token.admin === true)"
        }
      }
    }
  }
}
