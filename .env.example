# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# GITHUB_DEFAULT_TOKEN: Optional fallback GitHub Token. Configure in AI Studio secrets for compile-time injection.
# DO NOT COMMIT REAL TOKENS. Replace the value below with your secret in CI or local secrets file.
GITHUB_DEFAULT_TOKEN=REPLACE_WITH_GITHUB_PAT
