// Enumeração que identifica o subsistema envolvido na transição de estado
enum TIPO_ESTADO_SISTEMA
  {
   SISTEMA_ROBO,    // Subsistema de execução de ordens do robô
   SISTEMA_SICLO,   // Subsistema de ciclo de canais (Compra/Venda)
   SISTEMA_PRECOS   // Subsistema de organização da estrutura de preços
  };

// Enumeração que define a etapa atual de análise da estrutura de preços do ativo
enum ESTADO_DE_PRECOS
  {
   ESTADO_NOVO_CICLO,           // Início de um novo ciclo de preços
   ESTADO_EXPANSAO_RANGE,       // Expansão da faixa de negociação
   ESTADO_AJUSTE_CANAL,         // Ajuste fino do canal dinâmico
   ESTADO_CANAL_PRONTO,         // Canal pronto para rompimento
   ESTADO_ROMPIMENTO_CIMA,      // Rompimento confirmado para cima
   ESTADO_ROMPIMENTO_BAIXO,     // Rompimento confirmado para baixo
   ESTADO_DE_PRECOS_CONCLUIDO   // Conclusão da análise da estrutura de preços
  };

// Enumeração do ciclo de canais operacionais
enum ESTADO_SICLO
  {
   ESTADO_SICLO_DE_CANAL_INICIAL,           // Canal inicial aguardando sinal
   ESTADO_SICLO_DE_CANAL_COMPRA,            // Tendência de alta ativa (Compra)
   ESTADO_SICLO_DE_CANAL_VENDA,             // Tendência de baixa ativa (Venda)
   ESTADO_SICLO_DE_CANAL_COMPRA_FINALIZADO, // Operações de compra encerradas
   ESTADO_SICLO_DE_CANAL_VENDA_FINALIZADO   // Operações de venda encerradas
  };

// Enumeração dos estados operacionais e execução de ordens do robô
enum ESTADO_ROBO
  {
   ESTADO_DE_EXECUCAO_INICIAL = 0,        // Inicialização de variáveis e rotinas
   ESTADO_DE_EXECUCAO_COMPRA_INICIAL,     // Disparo de ordem de compra inicial
   ESTADO_DE_EXECUCAO_VENDA_INICIAL,      // Disparo de ordem de venda inicial
   ESTADO_DE_EXECUCAO_COMPRA_POSICAO,     // Gestão de posição aberta de compra
   ESTADO_DE_EXECUCAO_VENDA_POSICAO,      // Gestão de posição aberta de venda
   ESTADO_DE_EXECUCAO_MODIFICAR,          // Modificação de ordens
   ESTADO_DE_EXECUCAO_MODIFICAR_COMPRA,   // Modificação de ordens de compra
   ESTADO_DE_EXECUCAO_MODIFICAR_VENDA,    // Modificação de ordens de venda
   ESTADO_DE_EXECUCAO_REPOUSO             // Aguardando novas oportunidades
  };

// Enumeração que controla o estado da linha do equador e zonas dinâmicas
enum EST_EQUADOR
  {
   EQ_NEUTRO = 0,        // Estado neutro sem viés definido
   EQ_ATUALIZAR_ALTA,    // Sinal de atualização para zona de alta
   EQ_ATUALIZAR_BAIXA,   // Sinal de atualização para zona de baixa
   EQ_ALTA_Z1,           // Zona 1 de expansão de alta
   EQ_ALTA_Z2,           // Zona 2 de expansão de alta
   EQ_ALTA_Z3,           // Zona 3 de expansão de alta
   EQ_BAIXA_Z1,          // Zona 1 de expansão de baixa
   EQ_BAIXA_Z2,          // Zona 2 de expansão de baixa
   EQ_BAIXA_Z3           // Zona 3 de expansão de baixa
  };

// Estrutura com horário de início e fim da sessão Forex
struct SessaoForex
  {
   int               inicio_hora;   // Hora de abertura da sessão (0-23)
   int               inicio_minuto; // Minuto de abertura da sessão (0-59)
   int               fim_hora;      // Hora de fecho da sessão (0-23)
   int               fim_minuto;    // Minuto de fecho da sessão (0-59)
  };

// Estrutura para controle e deteção de transição da sessão Forex
struct ControleSessao
  {
   bool              estavaNaSessao; // Indica se o robô já estava dentro da sessão na última leitura
  };

