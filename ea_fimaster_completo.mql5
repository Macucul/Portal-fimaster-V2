            "</div>"
            "<h3 style='text-align: center; border-top: 2px solid #666; padding-top: 10px;'>✅ Mantenha-se atento às notificações.</h3>"
            "</div>"
            "</div>"
            "</body></html>"
         );
         return true;
      }
      else
      {
         Print("Erro ao modificar a ordem de compra - Bilhete: ", BilheteDeCompra);
      }
      return false;
   }
   return false;
}

